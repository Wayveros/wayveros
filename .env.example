# Copy these values into Vercel Environment Variables (or local .env.local).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Temporary admin route guard for development only; replace with Supabase Auth + admin roles before launch.
INTERNAL_ADMIN_APPROVAL_TOKEN=replace_with_a_long_random_value
APP_BASE_URL=http://localhost:3000

# Add only when implementing providers:
OPENAI_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=
